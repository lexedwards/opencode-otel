{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "files": { "includes": ["src/**", "test/**", "package.json", "tsconfig.json", "!test/fixtures/**"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "asNeeded", "trailingCommas": "none" } },
  "linter": {
    "rules": {
      "recommended": false,
      "correctness": { "noUnusedImports": "error", "noUnreachable": "error" },
      "suspicious": { "noDuplicateObjectKeys": "error", "noDoubleEquals": "error" }
    }
  }
}
